<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <title>TO-DO APP</title>
</head>
<body class="d-flex justify-content-center align-items-start vh-100 bg-light">

  <div class="card shadow-lg mt-5" style="width: 30rem;">
    <div class="card-header bg-primary text-white d-flex align-items-center">
      <h2 class="m-0 me-2">TO-DO List</h2>
      <img src="images/icon.png" alt="icon" style="width:40px;">
    </div>

    <div class="card-body">
      <div class="input-group mb-3">
        <input id="input-box" type="text" class="form-control" placeholder="Enter Task">
        <button onclick="Addtask()" class="btn btn-success">Add Task</button>
      </div>

      <ul id="list-container" class="p-0 m-0">
        <!-- Tasks will appear here -->
      </ul>
    </div>
  </div>

  <script src="script.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
